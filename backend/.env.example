# PostgreSQL
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=studysquad
# Set false for local PostgreSQL without TLS; defaults to TLS otherwise.
DB_SSL=false

# Authentication and admin access
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_SECRET=replace-with-a-separate-admin-secret

# Cloudinary (required for task, submission, chat, and mentor-photo uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server
PORT=3000
# Set true only when the app is behind one trusted reverse proxy.
TRUST_PROXY=false

# Rate limits (per client IP; values are requests per window)
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=10
REGISTRATION_RATE_LIMIT=5
ADMIN_RATE_LIMIT=60
UPLOAD_RATE_LIMIT=20
MESSAGE_RATE_LIMIT=60
MATCHING_RATE_LIMIT=10

# Optional stale squad cleanup threshold
SQUAD_EXPIRY_HOURS=48
