# Copy this file to .env.local and adjust if your backend isn't on the
# default localhost:3000. Not required otherwise -- lib/api.ts already
# defaults to http://localhost:3000 if this isn't set.
#
# Note: the frontend dev server runs on port 3001 (see package.json),
# not 3000 -- the backend already owns 3000 (backend/server.js), so
# running both locally at once needs them on different ports.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000